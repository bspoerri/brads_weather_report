# Personal config for the coastal report. Copy this file to
# `coastal.env` (which is gitignored) and fill in your own values.
#
#   cp coastal.env.example coastal.env

# Location to report on, "lat,lng". If unset, the report uses the
# cached my_coordinates.txt, or falls back to IP geolocation.
COASTAL_COORDS=43.0,-70.0

# Address the emailed report is sent FROM. Recipients are managed
# separately in recipients.txt.
COASTAL_SENDER=you@example.com

# SMTP credentials for sending the report (no Mail.app needed, so it
# works unattended from the 5am scheduler).
#   For Gmail: create an App Password at
#   https://myaccount.google.com/apppasswords and paste it here -- this
#   is NOT your normal Google password.
COASTAL_SMTP_PASSWORD=your-app-password-here

# SMTP server settings. Defaults below suit Gmail; override for another
# provider. Port 587 uses STARTTLS; 465 uses SSL. SMTP login defaults to
# COASTAL_SENDER if COASTAL_SMTP_USER is omitted.
COASTAL_SMTP_HOST=smtp.gmail.com
COASTAL_SMTP_PORT=587
#COASTAL_SMTP_USER=you@example.com

# Contact string sent in the NWS API User-Agent (their etiquette asks
# for a contact email). Optional.
COASTAL_CONTACT=brads-weather-report (you@example.com)
